{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../",
          "files": [
            "build/bin/RKM.DataStage.DSAPI/Release/net10.0-windows/RKM.DataStage.DSAPI.dll"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "api/**/*.yml",
          "guides/**/*.md",
          "guides/**/toc.yml"
        ]
      }
    ],
    "globalMetadata": {
      "_appTitle": "RKM.DataStage.DSAPI API Reference",
      "_appName": "RKM Research",
      "_appFooter": "<small>Published by <a href=\"https://rkmresearch.com/\">RKM Research Limited</a><br>IBM, DataStage and InfoSphere are trademarks or registered trademarks of International Business Machines Corporation in the United States, other countries, or both. RKM Research Ltd is independent of IBM; these tools and documents are not affiliated with, sponsored by or endorsed by IBM. Other product and company names belong to their respective trademark owners.</small>",
      "_enableSearch": true,
      "_appLogoPath": "images/rkm-logo.png",
      "_appFaviconPath": "images/rkm-logo.png",
      "_disableContribution": true
    },
    "template": [
      "default",
      "modern",
      "templates/rkm"
    ],
    "postProcessors": [
      "ExtractSearchIndex"
    ],
    "output": "_site",
    "resource": [
      {
        "files": [
          "images/rkm-logo.png"
        ]
      }
    ]
  }
}
